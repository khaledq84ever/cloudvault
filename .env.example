# Required in production
SECRET_KEY=change-me-to-a-long-random-hex
FLASK_ENV=production

# Storage: data dir for SQLite + uploads (point to mounted volume)
DATA_DIR=/app/data

# Optional: Postgres (Railway / Supabase / Neon)
# DATABASE_URL=postgresql://user:pass@host/dbname

# Optional: Cloudflare R2 / S3 (overrides local disk for file content)
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=cloudvault
# R2_KEY=...
# R2_SECRET=...

# Optional: per-user quota in bytes (default 15 GB)
# QUOTA_BYTES=16106127360

# Disable scheduled trash purge (default: enabled)
# ENABLE_SCHEDULER=0
